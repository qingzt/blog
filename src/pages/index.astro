---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getLabelColorClass } from '../lib/github-loader';

// 获取所有文章
const posts = await getCollection('posts');

// 按创建时间排序（最新优先）
const sortedPosts = posts.sort((a, b) => 
  b.data.createdAt.getTime() - a.data.createdAt.getTime()
);

// 格式化日期
function formatDate(date: Date): string {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).replace(/\//g, '-');
}

// 获取所有分类
const categories = [...new Set(posts.map(p => p.data.category?.name).filter(Boolean))];

// 获取所有标签及其计数
const tagCounts = new Map<string, number>();
posts.forEach(post => {
  post.data.labels.forEach(label => {
    tagCounts.set(label.name, (tagCounts.get(label.name) || 0) + 1);
  });
});
const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]);
---

<Layout title="首页 - Achuan-2 的博客">
  <div class="flex gap-6">
    <!-- 主要内容区 -->
    <div class="flex-1 min-w-0">
      <!-- 顶部导航 -->
      <nav class="flex flex-wrap items-center gap-2 mb-6 pb-4 border-b border-gray-200">
        <a href="/" class="px-4 py-2 text-sm text-orange-600 bg-orange-50 font-medium rounded-lg transition-colors">近期发布</a>
        <a href="/categories" class="px-4 py-2 text-sm text-gray-600 hover:text-gray-900 hover:bg-white rounded-lg transition-colors">分类</a>
        <a href="/tags" class="px-4 py-2 text-sm text-gray-600 hover:text-gray-900 hover:bg-white rounded-lg transition-colors">标签</a>
        <a href="/archives" class="px-4 py-2 text-sm text-gray-600 hover:text-gray-900 hover:bg-white rounded-lg transition-colors">归档</a>
        <a href="/guestbook" class="px-4 py-2 text-sm text-gray-600 hover:text-gray-900 hover:bg-white rounded-lg transition-colors">留言板</a>
        <a href="/search" class="ml-auto flex items-center gap-2 px-4 py-2 text-sm text-gray-600 hover:text-gray-900 hover:bg-white rounded-lg transition-colors">
          <span class="i-carbon-shuffle"></span>
          随机抽一篇文章吧
        </a>
      </nav>

      <!-- 文章列表 -->
      <div class="space-y-4">
        {sortedPosts.length === 0 ? (
          <div class="text-center py-20">
            <p class="text-gray-500 text-lg">暂无文章</p>
            <p class="text-sm text-gray-400 mt-2">
              在 GitHub Discussions 中创建第一篇文章吧！
            </p>
          </div>
        ) : (
          sortedPosts.map((post) => (
            <article class="bg-white rounded-lg p-6 shadow-sm hover:shadow-md transition-all border border-gray-100">
              <a href={`/posts/${post.data.number}`} class="block">
                <h2 class="text-xl font-semibold text-gray-900 hover:text-blue-600 transition-colors mb-3 line-clamp-2">
                  {post.data.title}
                </h2>
                
                <p class="text-gray-600 text-sm mb-4 line-clamp-2 leading-relaxed">
                  {post.data.excerpt}
                </p>
                
                <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
                  <!-- 发布日期 -->
                  <span class="flex items-center gap-1">
                    <span class="i-carbon-add-alt"></span>
                    发布: {formatDate(post.data.createdAt)}
                  </span>
                  
                  <!-- 更新日期 -->
                  <span class="flex items-center gap-1">
                    <span class="i-carbon-update-now"></span>
                    更新: {formatDate(post.data.updatedAt)}
                  </span>
                </div>
              </a>
            </article>
          ))
        )}
      </div>
    </div>

    <!-- 右侧栏 -->
    <aside class="w-72 flex-shrink-0 space-y-6 xl:block lg:hidden">
      <!-- 分类索引 -->
      <div class="bg-white rounded-lg p-5 shadow-sm border border-gray-100">
        <h3 class="text-base font-semibold text-gray-900 mb-4 pb-2 border-b border-gray-100">分类索引</h3>
        <div class="space-y-1">
          {categories.slice(0, 10).map(category => {
            const count = posts.filter(p => p.data.category?.name === category).length;
            return (
              <a href={`/category/${category}`} class="flex items-center gap-2 px-2 py-1.5 text-sm text-gray-700 hover:text-gray-900 hover:bg-gray-50 rounded transition-colors">
                <span class="i-carbon-folder text-sm"></span>
                <span class="flex-1">{category}</span>
                <span class="text-xs text-gray-400">({count})</span>
              </a>
            );
          })}
        </div>
      </div>

      <!-- 标签索引 -->
      <div class="bg-white rounded-lg p-5 shadow-sm border border-gray-100">
        <h3 class="text-base font-semibold text-gray-900 mb-4 pb-2 border-b border-gray-100">标签索引</h3>
        <div class="flex flex-wrap gap-2">
          {sortedTags.slice(0, 20).map(([tag, count]) => (
            <a href={`/tag/${tag}`} class="px-3 py-1 text-xs bg-gray-100 text-gray-700 hover:bg-gray-200 hover:text-gray-900 rounded-full transition-colors">
              {tag}
            </a>
          ))}
        </div>
      </div>
    </aside>
  </div>
</Layout>
  </div>
</Layout>
