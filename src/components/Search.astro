---
// 搜索组件 - 使用 Pagefind UI
---

<div id="search-container" class="search-wrapper">
  <div id="search"></div>
</div>

<script>
  // 等待 Pagefind UI 加载完成
  declare const PagefindUI: new (options: { element: string; showSubResults?: boolean; showImages?: boolean; excerptLength?: number; resetStyles?: boolean; translations?: Record<string, string> }) => void;

  function initSearch() {
    if (typeof PagefindUI !== 'undefined') {
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        excerptLength: 30,
        resetStyles: false,
        translations: {
          placeholder: '搜索文章...',
          zero_results: '没有找到相关结果',
          many_results: '找到 [COUNT] 条结果',
          one_result: '找到 1 条结果',
          alt_search: '没有找到 [SEARCH_TERM]。尝试搜索 [DIFFERENT_TERM]',
          search_suggestion: '没有找到 [SEARCH_TERM]。尝试以下搜索：',
          searching: '搜索中...',
        },
      });
    } else {
      // 如果 Pagefind UI 还没加载，稍后重试
      setTimeout(initSearch, 100);
    }
  }

  // 页面加载完成后初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSearch);
  } else {
    initSearch();
  }
</script>

<style is:global>
  .search-wrapper {
    @apply w-full max-w-2xl mx-auto;
  }

  /* Pagefind UI 样式覆盖 */
  .pagefind-ui {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #3b82f6;
    --pagefind-ui-text: #1f2937;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #e5e7eb;
    --pagefind-ui-tag: #f3f4f6;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.5rem;
    --pagefind-ui-font: inherit;
  }

  .pagefind-ui__search-input {
    @apply w-full px-4 py-3 border border-gray-300 rounded-lg text-base;
    @apply focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent;
    @apply transition-shadow;
  }

  .pagefind-ui__search-clear {
    @apply text-gray-400 hover:text-gray-600;
  }

  .pagefind-ui__results-area {
    @apply mt-4;
  }

  .pagefind-ui__message {
    @apply text-gray-500 text-center py-8;
  }

  .pagefind-ui__result {
    @apply p-4 mb-3 bg-white rounded-lg border border-gray-200;
    @apply hover:shadow-md transition-shadow;
  }

  .pagefind-ui__result-link {
    @apply text-lg font-semibold text-gray-900 hover:text-blue-600;
    @apply no-underline hover:underline;
  }

  .pagefind-ui__result-excerpt {
    @apply text-gray-600 text-sm mt-2 leading-relaxed;
  }

  .pagefind-ui__result-title {
    @apply flex items-center gap-2;
  }

  mark {
    @apply bg-yellow-200 text-gray-900 px-0.5 rounded;
  }
</style>
