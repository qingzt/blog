# GitHub API Token (需要 public_repo 权限)
# 获取地址: https://github.com/settings/tokens/new
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub 仓库信息 (格式: owner/repo)
GITHUB_OWNER=your-username
GITHUB_REPO=your-repo-name

# Giscus 配置 (从 https://giscus.app 获取)
# 1. 确保仓库是公开的
# 2. 安装 Giscus App: https://github.com/apps/giscus
# 3. 启用 Discussions 功能
GISCUS_REPO=your-username/your-repo-name
GISCUS_REPO_ID=R_xxxxxxxxxx
GISCUS_CATEGORY=Announcements
GISCUS_CATEGORY_ID=DIC_xxxxxxxxxxxx

# 站点 URL (用于 SEO 和 RSS)
SITE_URL=https://your-blog.com

# 部署目标 (GitHub Actions 会自动设置)
# GITHUB_PAGES=1
# VERCEL=1
